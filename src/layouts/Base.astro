---
import '@/styles/starwind.css';
import '@/styles/world.css';
import { ClientRouter } from 'astro:transitions';
import CartDrawer from '@/components/store/CartDrawer.svelte';
import SearchOverlay from '@/components/store/SearchOverlay.svelte';
import { dayMaterials, nightMaterials, themeVars } from '@/data/theme';
import { url } from '@/lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Share card image — a site path; it is made absolute below. */
  image?: string;
  type?: 'website' | 'product';
}

const {
  title = 'وقار — مقتنيات مختارة',
  description = 'متجر وقار: مقتنيات مختارة بمعيار واحد — الجودة والذوق والقيمة. توصيل داخل المملكة وإرجاع خلال ١٤ يومًا.',
  image,
  type = 'website',
} = Astro.props;

/* The theme is injected from the materials data: one source of truth.
   The night world arrives with the same shape, keyed off the document. */
const themeCss = `:root{${themeVars(dayMaterials)}} html[data-world='night']{${themeVars(nightMaterials)}}`;

const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="ar" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* The world: light by default; the lamp in the footer is the only door into
         the night. The choice is re-stamped onto every incoming document before
         the swap, because client-side navigation syncs <html> attributes — without
         this, the night would fall off on the first link a visitor clicks. */
      (function () {
        var read = function () {
          var saved = null;
          try {
            saved = localStorage.getItem('wq-world');
          } catch (error) {
            /* private mode: the light default holds */
          }
          return saved === 'night' ? 'night' : 'day';
        };
        document.documentElement.dataset.world = read();
        document.addEventListener('astro:before-swap', function (event) {
          event.newDocument.documentElement.dataset.world = read();
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="وقار" />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}

    <style is:inline set:html={themeCss} />
    <ClientRouter />
    <script is:inline>
      /* Scripts are on: hide images until they have arrived, then fade them in. */
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="group/page min-h-dvh bg-room font-sans text-room-ink antialiased">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="wq-word" viewBox="0 0 131.18 100" fill="currentColor">
          <path d="M0.00 94.05Q4.36 95.24 7.18 94.94Q10.00 94.65 11.58 93.26Q13.17 91.88 13.76 89.75Q14.36 87.62 14.36 85.14V48.61L28.22 45.54V85.14Q28.22 90.39 25.99 93.71Q23.76 97.02 20.20 98.56Q16.63 100.09 12.72 99.99Q8.81 99.89 5.40 98.36Q1.98 96.83 0.00 94.05ZM37.13 79.20Q37.13 79.20 36.14 79.15Q35.15 79.10 34.16 78.61Q33.17 78.11 33.17 76.93V3.07L47.03 0.00V65.34H54.95V79.20ZM50.99 79.20V65.34H78.71V52.67L92.57 45.54V76.93Q92.57 78.11 91.58 78.61Q90.59 79.10 89.60 79.15Q88.61 79.20 88.61 79.20ZM75.84 62.37Q71.28 62.37 67.42 60.10Q63.56 57.82 61.23 53.96Q58.91 50.10 58.91 45.54Q58.91 40.89 61.23 37.08Q63.56 33.27 67.42 30.99Q71.28 28.71 75.94 28.71Q80.49 28.71 84.25 30.99Q88.01 33.27 90.29 37.08Q92.57 40.89 92.57 45.54Q92.57 50.20 90.29 54.01Q88.01 57.82 84.25 60.10Q80.49 62.37 75.84 62.37ZM75.84 48.51Q77.12 48.51 77.92 47.67Q78.71 46.83 78.71 45.54Q78.71 44.25 77.92 43.41Q77.12 42.57 75.84 42.57Q74.55 42.57 73.66 43.41Q72.77 44.25 72.77 45.54Q72.77 46.83 73.66 47.67Q74.55 48.51 75.84 48.51ZM100.98 92.27Q106.63 93.76 109.94 93.11Q113.26 92.47 114.84 90.69Q116.43 88.91 116.87 87.07Q117.32 85.24 117.32 84.35V66.53L131.18 62.37V81.38Q131.18 87.22 128.71 90.94Q126.23 94.65 122.42 96.38Q118.61 98.11 114.40 98.11Q110.19 98.11 106.58 96.58Q102.96 95.04 100.98 92.27ZM131.18 62.37 114.45 45.54Q115.74 45.54 118.11 45.39Q120.49 45.24 123.11 44.70Q125.74 44.16 127.96 43.02Q130.19 41.88 131.18 40.00ZM114.45 79.20Q109.89 79.20 106.03 76.93Q102.17 74.65 99.85 70.79Q97.52 66.93 97.52 62.37Q97.52 57.72 99.85 53.91Q102.17 50.10 106.03 47.82Q109.89 45.54 114.55 45.54Q119.10 45.54 122.86 47.82Q126.63 50.10 128.90 53.91Q131.18 57.72 131.18 62.37Q131.18 67.03 128.90 70.84Q126.63 74.65 122.86 76.93Q119.10 79.20 114.45 79.20ZM114.45 65.34Q115.74 65.34 116.53 64.50Q117.32 63.66 117.32 62.37Q117.32 61.09 116.53 60.24Q115.74 59.40 114.45 59.40Q113.16 59.40 112.27 60.24Q111.38 61.09 111.38 62.37Q111.38 63.66 112.27 64.50Q113.16 65.34 114.45 65.34Z" />
          <path d="M84.25 12.9 L90.35 19.8 L84.25 26.7 L78.15 19.8 Z" />
          <path d="M67.12 12.9 L73.22 19.8 L67.12 26.7 L61.02 19.8 Z" />
        </symbol>
      </defs>
    </svg>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 focus:border focus:border-hairline focus:bg-exhibit focus:px-4 focus:py-2 focus:text-sm focus:text-ink"
    >
      تخطَّ إلى المحتوى
    </a>

    <slot />
    <CartDrawer client:load />
    <SearchOverlay client:load />

    <script is:inline>
      (function () {
        var reveal = function (image) {
          image.classList.remove('wq-loading');
        };

        document.addEventListener(
          'load',
          function (event) {
            if (event.target instanceof HTMLImageElement) reveal(event.target);
          },
          true
        );

        /* Hold each page's images until they arrive — again after a swap. */
        var hold = function () {
          document.querySelectorAll('img').forEach(function (image) {
            if (image.complete) reveal(image);
            else image.classList.add('wq-loading');
          });
        };

        hold();
        document.addEventListener('astro:page-load', hold);
      })();
    </script>
  </body>
</html>
