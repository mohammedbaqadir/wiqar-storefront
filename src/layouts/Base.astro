---
import '@/styles/starwind.css';
import '@/styles/world.css';
import { ClientRouter } from 'astro:transitions';
import CartDrawer from '@/components/store/CartDrawer.svelte';
import SearchOverlay from '@/components/store/SearchOverlay.svelte';
import { dayMaterials, nightMaterials, themeVars } from '@/data/theme';
import { url } from '@/lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Share card image — a site path; it is made absolute below. */
  image?: string;
  type?: 'website' | 'product';
}

const {
  title = 'وقار — مقتنيات مختارة',
  description = 'متجر وقار: مقتنيات مختارة بمعيار واحد — الجودة والذوق والقيمة. توصيل داخل المملكة وإرجاع خلال ١٤ يومًا.',
  image,
  type = 'website',
} = Astro.props;

/* The theme is injected from the materials data: one source of truth.
   The night world arrives with the same shape, keyed off the document. */
const themeCss = `:root{${themeVars(dayMaterials)}} html[data-world='night']{${themeVars(nightMaterials)}}`;

const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="ar" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* The world: light by default; the lamp in the footer is the only door into
         the night. The choice is re-stamped onto every incoming document before
         the swap, because client-side navigation syncs <html> attributes — without
         this, the night would fall off on the first link a visitor clicks. */
      (function () {
        var read = function () {
          var saved = null;
          try {
            saved = localStorage.getItem('wq-world');
          } catch (error) {
            /* private mode: the light default holds */
          }
          return saved === 'night' ? 'night' : 'day';
        };
        document.documentElement.dataset.world = read();
        document.addEventListener('astro:before-swap', function (event) {
          event.newDocument.documentElement.dataset.world = read();
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="وقار" />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}

    <style is:inline set:html={themeCss} />
    <ClientRouter />
    <script is:inline>
      /* Scripts are on: hide images until they have arrived, then fade them in. */
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="group/page min-h-dvh bg-room font-sans text-room-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 focus:border focus:border-hairline focus:bg-exhibit focus:px-4 focus:py-2 focus:text-sm focus:text-ink"
    >
      تخطَّ إلى المحتوى
    </a>

    <slot />
    <CartDrawer client:load />
    <SearchOverlay client:load />

    <script is:inline>
      (function () {
        var reveal = function (image) {
          image.classList.remove('wq-loading');
        };

        document.addEventListener(
          'load',
          function (event) {
            if (event.target instanceof HTMLImageElement) reveal(event.target);
          },
          true
        );

        /* Hold each page's images until they arrive — again after a swap. */
        var hold = function () {
          document.querySelectorAll('img').forEach(function (image) {
            if (image.complete) reveal(image);
            else image.classList.add('wq-loading');
          });
        };

        hold();
        document.addEventListener('astro:page-load', hold);
      })();
    </script>
  </body>
</html>
