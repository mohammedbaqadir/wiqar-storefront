---
import '@/styles/starwind.css';
import '@/styles/world.css';
import { ClientRouter } from 'astro:transitions';
import CartDrawer from '@/components/store/CartDrawer.svelte';
import SearchOverlay from '@/components/store/SearchOverlay.svelte';
import { dayMaterials, nightMaterials, themeVars } from '@/data/theme';
import { url } from '@/lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Share card image — a site path; it is made absolute below. */
  image?: string;
  type?: 'website' | 'product';
}

const {
  title = 'وقار — مقتنيات مختارة',
  description = 'متجر وقار: مقتنيات مختارة بمعيار واحد — الجودة والذوق والقيمة. توصيل داخل المملكة وإرجاع خلال ١٤ يومًا.',
  image,
  type = 'website',
} = Astro.props;

/* The theme is injected from the materials data: one source of truth.
   The night world arrives with the same shape, keyed off the document. */
const themeCss = `:root{${themeVars(dayMaterials)}} html[data-world='night']{${themeVars(nightMaterials)}}`;

const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="ar" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* The world: light by default; the lamp in the footer is the only door into
         the night. The choice is re-stamped onto every incoming document before
         the swap, because client-side navigation syncs <html> attributes — without
         this, the night would fall off on the first link a visitor clicks. */
      (function () {
        var read = function () {
          var saved = null;
          try {
            saved = localStorage.getItem('wq-world');
          } catch (error) {
            /* private mode: the light default holds */
          }
          return saved === 'night' ? 'night' : 'day';
        };
        document.documentElement.dataset.world = read();
        document.addEventListener('astro:before-swap', function (event) {
          event.newDocument.documentElement.dataset.world = read();
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="وقار" />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}

    <style is:inline set:html={themeCss} />
    <ClientRouter />
    <script is:inline>
      /* Scripts are on: hide images until they have arrived, then fade them in. */
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="group/page min-h-dvh bg-room font-sans text-room-ink antialiased">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="wq-word" viewBox="0 0 142.64 100" fill="currentColor">
          <path d="M13.41 69.51C13.41 79.89 9.95 85.35 1.70 91.73C-0.57 93.60 -0.57 95.59 1.70 97.99C3.96 100.52 6.09 100.52 8.09 98.79C17.14 90.94 21.13 81.75 21.13 68.44C21.13 61.39 19.66 51.54 15.54 31.84C15.01 29.05 13.68 28.11 10.35 28.91C6.89 29.71 6.36 31.18 7.02 33.97C11.68 53.80 13.41 63.12 13.41 69.51ZM30.45 0.70C27.25 1.23 26.85 2.56 27.25 5.09C30.05 20.79 34.04 41.69 36.30 53.93C39.36 70.97 45.49 75.63 52.81 76.43L54.14 75.10V67.24L52.81 65.91C49.08 65.38 46.02 63.52 43.89 51.67C41.63 38.76 37.90 18.53 35.24 3.63C34.84 1.23 33.64 0.16 30.45 0.70ZM74.10 19.86C65.58 19.86 57.46 29.45 57.46 43.69C57.46 53.93 62.39 60.06 73.30 60.06C77.43 60.06 82.88 58.99 87.14 56.73C85.95 63.52 78.63 66.05 57.06 66.05C56.13 66.05 54.67 66.05 52.81 65.91L51.47 67.24V75.10L52.81 76.43C54.27 76.56 55.47 76.56 56.13 76.56C85.01 76.56 95.13 67.91 95.13 52.20C95.13 35.70 85.55 19.86 74.10 19.86ZM65.18 42.75C65.18 35.43 68.91 30.38 73.83 30.38C79.69 30.38 85.55 38.10 87.01 49.01C83.02 50.21 78.63 50.61 74.63 50.61C67.45 50.61 65.18 47.95 65.18 42.75ZM119.35 28.51C108.97 28.51 101.78 36.77 101.78 48.61C101.78 60.72 108.57 70.84 120.82 72.97C126.01 73.90 130.40 73.63 133.73 72.70C130.80 83.22 122.55 87.74 110.44 90.14C107.24 90.80 106.44 92.40 107.24 95.73C108.04 99.45 109.64 100.25 112.70 99.59C130.80 95.73 142.64 84.81 142.64 62.45C142.64 42.22 131.60 28.51 119.35 28.51ZM123.08 63.52C114.03 61.79 109.50 56.33 109.50 48.88C109.50 42.62 113.50 39.03 119.22 39.03C127.60 39.03 134.93 47.55 134.93 62.85V63.65C131.46 64.45 127.21 64.32 123.08 63.52Z" />
          <path d="M77.81 0.03 L83.41 5.53 L77.81 11.03 L72.21 5.53 Z" />
          <path d="M63.7 0.3 L69.3 5.8 L63.7 11.3 L58.1 5.8 Z" />
        </symbol>
      </defs>
    </svg>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 focus:border focus:border-hairline focus:bg-exhibit focus:px-4 focus:py-2 focus:text-sm focus:text-ink"
    >
      تخطَّ إلى المحتوى
    </a>

    <slot />
    <CartDrawer client:load />
    <SearchOverlay client:load />

    <script is:inline>
      (function () {
        var reveal = function (image) {
          image.classList.remove('wq-loading');
        };

        document.addEventListener(
          'load',
          function (event) {
            if (event.target instanceof HTMLImageElement) reveal(event.target);
          },
          true
        );

        /* Hold each page's images until they arrive — again after a swap. */
        var hold = function () {
          document.querySelectorAll('img').forEach(function (image) {
            if (image.complete) reveal(image);
            else image.classList.add('wq-loading');
          });
        };

        hold();
        document.addEventListener('astro:page-load', hold);
      })();
    </script>
  </body>
</html>
