---
import '@/styles/starwind.css';
import '@/styles/world.css';
import { materials, themeVars } from '@/data/theme';

const themeCss = `:root{${themeVars(materials)}}`;

/**
 * الليل — الجولة الثانية. A lab page, not part of the store.
 *
 * Round 1 verdicts: the greige ground with a light plinth wins for day; bare is
 * out; frames are out; and the "spot" failed because the halo was hidden behind
 * the photo — it only ever showed as an 8px rim. Here the halo gets room, four
 * dark walls are on trial, and the day-winning plinth walks into the night.
 */

const picks = [
  { key: 'wq-002', name: 'قلم حبر خشبي', lum: 0 },
  { key: 'wq-023', name: 'طقم فنجان قهوة عربي', lum: 13 },
  { key: 'wq-032', name: 'حزام جلد كلاسيكي', lum: 41 },
  { key: 'wq-025', name: 'دلة قهوة نحاسية', lum: 75 },
  { key: 'wq-014', name: 'عطر عنبر هادئ', lum: 211 },
  { key: 'wq-021', name: 'طقم مناديل كتان', lum: 232 },
];

const walls = [
  { hex: '#1c1b19', name: 'حبر التذييل', note: 'الحالي' },
  { hex: '#221e18', name: 'فحم دافئ', note: 'أكثر دفئًا' },
  { hex: '#26221a', name: 'عنبري عميق', note: 'أفتح، أدفأ' },
  { hex: '#1a1e1b', name: 'زيتوني داكن', note: 'بارد قليلًا' },
];

const treatments = [
  { id: 'halo', label: 'ضوء قوي', wrap: 'n-halo', inner: '', note: 'هالة واسعة خلف القطعة، بمساحة تسمح لها' },
  { id: 'plinth-white', label: 'منصّة بيضاء', wrap: '', inner: 'n-slab', note: 'الفائزة نهارًا، في الليل' },
  { id: 'plinth-warm', label: 'منصّة دافئة', wrap: '', inner: 'n-plinth-warm', note: 'سطح أدفأ بدرجتين من الجدار' },
  { id: 'pool', label: 'حوض ضوء', wrap: 'n-pool', inner: '', note: 'الضوء تحت القطعة، لا خلفها' },
  { id: 'plinth-halo', label: 'منصّة داخل ضوء', wrap: 'n-plinth-halo', inner: 'n-slab', note: 'المنصّة البيضاء وهالة خلفها' },
];

const sample = 'كل قطعة تصل إلى المتجر تمرّ بثلاثة أسئلة: هل تُصنع كما ينبغي؟ هل تخدم استعمالًا حقيقيًا؟ وهل يبقى سعرها معقولًا بعد سنوات؟ ما لا يجتاز الأسئلة الثلاثة لا يُعرض — ولذلك قائمة المتجر قصيرة دائمًا.';
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>الليل — الجولة الثانية — وقار</title>
    <style is:inline set:html={themeCss} />
    <style is:inline>
      /* treatments */
      .n-halo {
        padding: 1.5rem;
        background:
          radial-gradient(75% 55% at 50% 42%, rgba(242, 239, 230, 0.21), transparent 72%),
          radial-gradient(135% 105% at 50% 45%, rgba(242, 239, 230, 0.08), transparent 78%);
      }
      .n-slab {
        padding: 0.5rem;
        background: #f7f5ef;
        box-shadow: 0 26px 54px -30px rgba(0, 0, 0, 0.9);
      }
      .n-plinth-warm {
        padding: 0.5rem;
        background: #2b2620;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.08),
          0 24px 48px -32px rgba(0, 0, 0, 0.9);
      }
      .n-pool {
        padding: 1rem 1rem 2.5rem;
        background: radial-gradient(90% 68% at 50% 92%, rgba(242, 239, 230, 0.22), transparent 74%);
      }
      .n-plinth-halo {
        padding: 1.75rem;
        background: radial-gradient(80% 60% at 50% 45%, rgba(242, 239, 230, 0.16), transparent 72%);
      }
    </style>
  </head>

  <body>
    <header class="mx-auto max-w-6xl px-5 pt-10 lg:px-8">
      <p class="font-data text-[0.7rem] tracking-[0.2em] text-room-ink-3" dir="ltr">LAB · NIGHT II</p>
      <h1 class="mt-2 font-display text-3xl text-room-ink lg:text-4xl">الليل — الجولة الثانية</h1>
      <p class="mt-3 max-w-2xl font-reading text-lg leading-loose text-room-ink-2">
        الحكم من الجولة الأولى: في النهار، الأرضية <span dir="ltr">#edeae3</span> مع منصّة فاتحة هي
        الفائزة — وتُثبَّت. المباشر خارج، والإطار خارج. أمّا «الضوء» فقد فشل ظلمًا: الهالة كانت
        محجوبة خلف الصورة نفسها، ولم يظهر منها إلا شريط بسمك ثماني بكسلات. هنا تأخذ الهالة مساحتها،
        وأربعة جدران داكنة تُعرض مع الفائز النهاري وهو يمشي في الليل.
      </p>
    </header>

    <section class="mt-10 bg-deep py-12 text-deep-ink">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="border-b border-current/15 pb-4">
          <h2 class="font-display text-2xl">الجدران</h2>
          <p class="mt-1 text-xs text-deep-ink-2">المنصّة البيضاء على أربعة جدران — نفس القطع، نفس العرض.</p>
        </div>

        <div class="mt-6 space-y-8">
          {walls.map((wall) => (
            <div>
              <div class="mb-3 flex items-baseline gap-3">
                <h3 class="font-display text-lg">{wall.name}</h3>
                <p class="font-data text-[0.7rem] text-deep-ink-2" dir="ltr">{wall.hex}</p>
                <p class="text-xs text-deep-ink-2">{wall.note}</p>
              </div>
              <div class="grid max-w-2xl grid-cols-3 gap-4 p-4" style={`background:${wall.hex}`}>
                {[picks[0], picks[3], picks[5]].map((p) => (
                  <figure>
                    <div class="n-slab">
                      <img
                        src={`/images/${p.key}-1-600.jpg`}
                        alt={p.name}
                        width="600"
                        height="750"
                        loading="lazy"
                        class="aspect-[4/5] w-full object-cover"
                      />
                    </div>
                    <figcaption class="mt-1.5 truncate text-[0.62rem] text-deep-ink-2">{p.name}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-deep py-12 text-deep-ink">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="border-b border-current/15 pb-4">
          <h2 class="font-display text-2xl">طرائق العرض</h2>
          <p class="mt-1 text-xs text-deep-ink-2">خمس طرائق على الجدار الحالي <span dir="ltr">#1c1b19</span> — ست قطع من أغمقها إلى أفتحها.</p>
        </div>

        {treatments.map((t) => (
          <div class="mt-8">
            <div class="mb-3 flex items-baseline gap-3">
              <h3 class="font-display text-lg">{t.label}</h3>
              <p class="text-xs text-deep-ink-2">{t.note}</p>
            </div>
            <div class="grid grid-cols-3 gap-3 bg-deep p-2 md:grid-cols-6">
              {picks.map((p) => (
                <figure>
                  <div class={t.wrap}>
                    <div class={t.inner}>
                      <img
                        src={`/images/${p.key}-1-600.jpg`}
                        alt={p.name}
                        width="600"
                        height="750"
                        loading="lazy"
                        class="aspect-[4/5] w-full object-cover"
                      />
                    </div>
                  </div>
                  {t.id === 'halo' && (
                    <figcaption class="mt-1.5 truncate text-[0.62rem] text-deep-ink-2">{p.name}</figcaption>
                  )}
                </figure>
              ))}
            </div>
          </div>
        ))}

        <div class="mt-10 grid max-w-3xl grid-cols-2 gap-4" style="background:#1c1b19">
          <figure class="p-6">
            <div class="n-halo">
              <img src="/images/wq-002-1-1200.jpg" alt="قلم حبر خشبي" width="1200" height="1500" loading="lazy" class="w-full" />
            </div>
            <figcaption class="mt-2 text-xs text-deep-ink-2">أغمق صورة — داخل الهالة الواسعة</figcaption>
          </figure>
          <figure class="p-6">
            <div class="n-halo">
              <img src="/images/wq-021-1-1200.jpg" alt="طقم مناديل كتان" width="1200" height="1500" loading="lazy" class="w-full" />
            </div>
            <figcaption class="mt-2 text-xs text-deep-ink-2">أفتح صورة — داخل الهالة الواسعة</figcaption>
          </figure>
        </div>

        <div class="mt-10 max-w-prose space-y-4 border-t border-current/15 pt-6">
          <h3 class="font-display text-xl">الحروف على هذا الجدار</h3>
          <p class="font-display text-3xl leading-snug">الجودة والذوق والقيمة في رتبة واحدة</p>
          <p class="font-reading text-lg leading-loose">{sample}</p>
          <p class="font-reading text-xl">٢٩٠ ر.س · ٤٢٠ ر.س · ١٢٥٠ ر.س</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-5 py-12 lg:px-8">
      <h2 class="font-display text-2xl text-room-ink">في هذه الجولة</h2>
      <ul class="mt-4 max-w-2xl list-disc space-y-2 pe-6 font-reading text-base leading-loose text-room-ink-2">
        <li>«ضوء قوي» الآن يظهر فعلًا — هل هو ما توقّعته، أم مبالغ فيه، أم ما زال خافتًا؟</li>
        <li>«منصّة بيضاء» في الليل: قطعة معروضة على مسطبة مضاءة داخل غرفة داكنة — هل تبدو فاخرة أم نهارًا ملصوقًا على ليل؟</li>
        <li>«منصّة دافئة» مقابل «منصّة بيضاء»: أيّهما يبدو أرخص؟</li>
        <li>الجدران الأربعة: هل <span dir="ltr">#1c1b19</span> فعليًا هو الأنسب، أم أن الدفء الإضافي في <span dir="ltr">#26221a</span> أو الصفاء في <span dir="ltr">#1a1e1b</span> أكثر أناقة؟</li>
        <li>الحروف: هل يحتاج أميري وزنًا أو حجمًا مختلفين على أي من هذه الجدران؟</li>
      </ul>
    </section>
  </body>
</html>
