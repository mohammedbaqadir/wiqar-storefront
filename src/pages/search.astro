---
import Base from '@/layouts/Base.astro';
import SiteHeader from '@/components/world/SiteHeader.astro';
import SiteFooter from '@/components/world/SiteFooter.astro';
import ProductGrid from '@/components/world/ProductGrid.astro';
import { getProducts } from '@/lib/api';
import { url } from '@/lib/url';

const products = await getProducts();
---

<Base title="البحث — وقار" description="ابحث في مقتنيات وقار بالاسم أو الرقم أو الوصف.">
  <SiteHeader />

  <main id="main">
    <header class="border-b border-hairline bg-exhibit-2">
      <div class="mx-auto max-w-6xl px-5 py-10 lg:px-8 lg:py-12">
        <h1
          data-search-heading
          class="font-display text-4xl leading-tight text-room-ink lg:text-5xl"
        >
          ابحث في المتجر
        </h1>

        <form
          action={url('/search')}
          method="get"
          role="search"
          class="relative mt-6 flex max-w-md items-center gap-3 border border-hairline bg-exhibit px-3.5 focus-within:border-outline focus-within:ring-2 focus-within:ring-outline/40"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            class="size-4 shrink-0 text-room-ink-3"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="6"></circle>
            <path d="M20 20l-4.2-4.2"></path>
          </svg>
          <input
            type="search"
            name="q"
            data-search-input
            autocomplete="off"
            placeholder="اكتب اسم قطعة أو رقمها"
            aria-label="ابحث في المتجر"
            role="combobox"
            aria-expanded="false"
            aria-autocomplete="list"
            aria-controls="search-suggestions"
            class="wq-field-bare min-h-11 w-full text-sm text-ink placeholder:text-room-ink-3"
          />
          <button
            type="submit"
            class="inline-flex min-h-11 shrink-0 items-center px-1 text-sm text-room-ink-2 transition-colors hover:text-room-ink"
          >
            ابحث
          </button>

          <ul
            id="search-suggestions"
            data-suggestions
            role="listbox"
            aria-label="اقتراحات"
            hidden
            class="absolute inset-x-0 top-full z-30 mt-1 max-h-80 overflow-y-auto border border-hairline bg-exhibit shadow-lg"
          >
          </ul>
        </form>

        <p data-search-count class="mt-4 font-data text-[0.8rem] text-room-ink-2"></p>
      </div>
    </header>

    <script is:inline>
      (function () {
        var query = new URLSearchParams(location.search).get('q');
        if (!query) return;
        document.documentElement.setAttribute('data-filtering', '');
        var input = document.querySelector('[data-search-input]');
        if (input) input.value = query;
      })();
    </script>

    <div data-client-filter>
      <ProductGrid products={products} indexed />
    </div>

    <div data-search-empty class="mx-auto hidden max-w-6xl px-5 py-20 text-center lg:px-8">
      <p class="font-display text-2xl text-room-ink">
        لا نتائج لـ «<span data-search-empty-query></span>»
      </p>
      <p class="mx-auto mt-3 max-w-md font-reading text-base leading-loose text-room-ink-2">
        جرّب كلمة أقصر، أو ابحث بالرقم المكتوب على القطعة، أو تصفّح المتجر كاملًا.
      </p>
      <a
        href={url('/catalog')}
        class="mt-6 inline-flex min-h-11 items-center border border-hairline px-5 text-sm text-room-ink transition-colors hover:bg-exhibit"
      >
        تصفّح المتجر
      </a>
    </div>
  </main>

  <SiteFooter />
</Base>

<script>
  import { money, toArabicDigits } from '@/lib/format';
  import { scoreMatch } from '@/lib/search';

  const results = document.querySelector<HTMLElement>('[data-client-filter]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-product-card]'));
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const heading = document.querySelector<HTMLElement>('[data-search-heading]');
  const countEl = document.querySelector<HTMLElement>('[data-search-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-search-empty]');
  const emptyQueryEl = document.querySelector<HTMLElement>('[data-search-empty-query]');
  const suggestions = document.querySelector<HTMLElement>('[data-suggestions]');

  if (results && cards.length > 0) {
    let activeIndex = -1;

    const closeSuggestions = () => {
      if (!suggestions || !input) return;
      suggestions.hidden = true;
      suggestions.replaceChildren();
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      activeIndex = -1;
    };

    /** The six closest matches, offered while the shopper is still typing. */
    const suggest = (query: string) => {
      if (!suggestions || !input || input.value.trim().length < 2) {
        closeSuggestions();
        return;
      }

      const matches = cards
        .map((card) => ({
          card,
          ...scoreMatch(card.dataset.search ?? '', card.dataset.name ?? '', query),
        }))
        .filter((entry) => entry.matched)
        .sort((a, b) => b.score - a.score)
        .slice(0, 6);

      if (matches.length === 0) {
        closeSuggestions();
        return;
      }

      suggestions.replaceChildren(
        ...matches.map((entry, index) => {
          const item = document.createElement('li');
          item.id = `suggestion-${index}`;
          item.setAttribute('role', 'option');
          item.setAttribute('aria-selected', 'false');

          const link = document.createElement('a');
          link.href = entry.card.querySelector('a')?.getAttribute('href') ?? '#';
          link.className =
            'flex items-center justify-between gap-3 px-4 py-3 text-sm text-ink transition-colors hover:bg-exhibit-2';

          const name = document.createElement('span');
          name.textContent = entry.card.querySelector('h3')?.textContent?.trim() ?? '';

          const price = document.createElement('span');
          price.className = 'wq-price text-[0.95rem] text-ink-3';
          price.textContent = money(Number(entry.card.dataset.price ?? 0));

          link.append(name, price);
          item.append(link);
          return item;
        })
      );

      suggestions.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      activeIndex = -1;
    };

    const apply = (raw: string) => {
      const query = raw.trim();
      document.documentElement.removeAttribute('data-filtering');

      let shown = 0;
      cards.forEach((card) => {
        const { matched, score } = scoreMatch(
          card.dataset.search ?? '',
          card.dataset.name ?? '',
          query
        );
        card.style.display = matched ? '' : 'none';
        card.style.order = matched ? String(-score) : '';
        if (matched) shown += 1;
      });

      const searching = query.length > 0;

      if (heading) heading.textContent = searching ? 'نتائج البحث' : 'ابحث في المتجر';
      if (countEl) {
        countEl.textContent = searching
          ? `${toArabicDigits(shown)} ${shown === 1 ? 'نتيجة' : 'نتائج'} لـ «${query}»`
          : '';
      }
      if (emptyEl) {
        const nothingFound = searching && shown === 0;
        emptyEl.style.display = nothingFound ? 'block' : 'none';
        if (nothingFound && emptyQueryEl) emptyQueryEl.textContent = query;
      }

      /* Keep the address shareable while typing. */
      const next = new URL(location.href);
      if (searching) next.searchParams.set('q', query);
      else next.searchParams.delete('q');
      history.replaceState(null, '', next);
    };

    input?.addEventListener('input', () => {
      apply(input.value);
      suggest(input.value);
    });

    input?.addEventListener('keydown', (event) => {
      const options = Array.from(suggestions?.querySelectorAll<HTMLElement>('li') ?? []);
      if (options.length === 0) return;

      if (event.key === 'ArrowDown') activeIndex = (activeIndex + 1) % options.length;
      else if (event.key === 'ArrowUp') activeIndex = (activeIndex - 1 + options.length) % options.length;
      else if (event.key === 'Escape') {
        closeSuggestions();
        return;
      } else if (event.key === 'Enter' && activeIndex >= 0) {
        event.preventDefault();
        options[activeIndex].querySelector('a')?.click();
        return;
      } else return;

      event.preventDefault();
      options.forEach((option, index) =>
        option.setAttribute('aria-selected', String(index === activeIndex))
      );
      const active = options[activeIndex];
      if (active && input) {
        input.setAttribute('aria-activedescendant', active.id);
        active.scrollIntoView({ block: 'nearest' });
      }
    });

    /* Keep focus in the field while a suggestion is clicked, then close on blur. */
    suggestions?.addEventListener('mousedown', (event) => event.preventDefault());
    input?.addEventListener('blur', closeSuggestions);

    apply(new URLSearchParams(location.search).get('q') ?? '');
  }
</script>
