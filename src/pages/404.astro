---
import Base from '@/layouts/Base.astro';
import SiteHeader from '@/components/store/SiteHeader.astro';
import SiteFooter from '@/components/store/SiteFooter.astro';
import CategoryNav from '@/components/store/CategoryNav.astro';
import { url } from '@/lib/url';

const linkClass =
  'inline-flex min-h-11 items-center border border-hairline px-5 text-sm text-room-ink transition-colors hover:bg-exhibit';
---

<Base title="لم نجد هذه الصفحة — وقار">
  <SiteHeader />

  <main id="main" class="mx-auto max-w-6xl px-5 py-20 lg:px-8">
    <p class="font-data text-[0.75rem] tracking-[0.18em] text-accent-d" dir="ltr">404</p>
    <h1 class="mt-2 font-display text-4xl leading-tight text-room-ink lg:text-5xl">
      لم نجد هذه الصفحة
    </h1>
    <p class="mt-4 max-w-prose font-reading text-lg leading-loose text-room-ink-2">
      الرابط الذي وصلت منه لم يعد موجودًا. تصفّح الأقسام، أو ابحث عن القطعة باسمها أو رقمها.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={url('/catalog')} class={linkClass}>كل المقتنيات</a>
      <a href={url('/search')} class={linkClass}>ابحث في المتجر</a>
    </div>

    <div class="mt-12 space-y-4">
      <h2 class="text-[0.7rem] tracking-[0.12em] text-room-ink-3">الأقسام</h2>
      <CategoryNav />
    </div>
  </main>

  <SiteFooter />
</Base>
