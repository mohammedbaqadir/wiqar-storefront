---
import Base from '@/layouts/Base.astro';
import SiteHeader from '@/components/world/SiteHeader.astro';
import SiteFooter from '@/components/world/SiteFooter.astro';
import ProductGrid from '@/components/world/ProductGrid.astro';
import ProductPhoto from '@/components/world/ProductPhoto.astro';
import Button from '@/components/starwind/button/Button.astro';
import {
  getCategory,
  getProduct,
  getProducts,
  getRelated,
  isLowStock,
  isOnSale,
  isOutOfStock,
  lowStockLabel,
} from '@/lib/api';
import { money } from '@/lib/format';
import { productSchema } from '@/lib/schema';
import { url } from '@/lib/url';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const category = await getCategory(product.category_id);
const related = await getRelated(product);

/** The catalogue may carry one image or several; both render. */
const gallery = product.images.length > 0 ? product.images : [product.image];
const showThumbs = gallery.length > 1;

const gone = isOutOfStock(product);
const thumbnail = product.image.thumb ?? product.image.url;

/** Each thumbnail swaps the stage to the catalogue URL. */
const stageUrls = gallery.map((image) => image.url);

const availability = gone
  ? 'نفدت الكمية'
  : isLowStock(product)
    ? lowStockLabel(product)
    : 'متوفّرة';

const share = product.image.url;
const schema = productSchema(product, {
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: share ? new URL(share, Astro.site).href : undefined,
  category,
});
---

<Base
  title={`${product.name} — وقار`}
  description={product.description}
  image={share}
  type="product"
>
  <SiteHeader />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main id="main">
    <nav
      class="mx-auto flex max-w-6xl items-center gap-2 px-5 pt-6 font-data text-[0.8rem] text-room-ink-3 lg:px-8"
      aria-label="المسار"
    >
      <a href={url('/')} class="transition-colors hover:text-room-ink">وقار</a>
      <span aria-hidden="true">‹</span>
      <a href={url('/catalog')} class="transition-colors hover:text-room-ink">المقتنيات</a>
      {
        category && (
          <>
            <span aria-hidden="true">‹</span>
            <a href={url(`/category/${category.slug}`)} class="transition-colors hover:text-room-ink">
              {category.name}
            </a>
          </>
        )
      }
      <span aria-hidden="true">‹</span>
      <span class="text-room-ink">{product.name}</span>
    </nav>

    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-8 lg:grid-cols-2 lg:gap-14 lg:px-8">
      <div class="space-y-3">
        <div class="relative aspect-square w-full overflow-hidden wq-mount">
          <ProductPhoto
            path={gallery[0].url}
            alt={gallery[0].alt}
            priority
            data-gallery-main
            class:list={[
              'size-full object-cover transition-opacity duration-300 ease-out motion-reduce:transition-none',
              gone && 'opacity-55',
            ]}
          />

          {
            gone && (
              <span class="absolute start-4 top-4 bg-ink px-2.5 py-1 font-data text-[0.7rem] text-exhibit">
                نفدت الكمية
              </span>
            )
          }

          {
            !gone && isLowStock(product) && (
              <span class="absolute start-4 top-4 bg-signal px-2.5 py-1 font-data text-[0.7rem] text-exhibit">
                {lowStockLabel(product)}
              </span>
            )
          }
        </div>

        {
          showThumbs && (
            <ul class="flex flex-wrap gap-2" aria-label="صور القطعة">
              {gallery.map((image, index) => (
                <li>
                  <button
                    type="button"
                    data-gallery-thumb
                    data-src={stageUrls[index]}
                    data-alt={image.alt}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    aria-label={`عرض الصورة ${index + 1}`}
                    class="block size-20 overflow-hidden border border-hairline bg-exhibit-2 opacity-70 transition-opacity hover:opacity-100 aria-pressed:border-outline aria-pressed:opacity-100"
                  >
                    <ProductPhoto
                      path={image.thumb ?? image.url}
                      alt=""
                      class="size-full object-cover"
                    />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="space-y-7">
        <div class="space-y-4 border-b border-hairline pb-6">
          <div class="flex flex-wrap items-center gap-3 font-data text-[0.8rem] text-room-ink-3">
            <span dir="ltr">{product.sku}</span>
            {category && <span aria-hidden="true">·</span>}
            {category && <a href={url(`/category/${category.slug}`)} class="transition-colors hover:text-room-ink">{category.name}</a>}
            {product.origin && <span class="ms-auto">{product.origin}</span>}
          </div>

          <h1 class="font-display text-4xl leading-tight text-room-ink lg:text-5xl">
            {product.name}
          </h1>

          <p class="font-reading text-lg leading-loose text-room-ink-2">{product.description}</p>
        </div>

        <div class="flex items-end gap-4">
          {
            isOnSale(product) ? (
              <>
                <span class="wq-price text-3xl text-room-ink">
                  {money(product.sale_price ?? product.price)}
                </span>
                <span class="wq-price text-base text-room-ink-3 line-through">
                  {money(product.regular_price)}
                </span>
              </>
            ) : (
              <span class="wq-price text-3xl text-room-ink">{money(product.price)}</span>
            )
          }
        </div>

        <div data-buy class="space-y-5">
          {
            product.options.map((option, optionIndex) => (
              <fieldset class="space-y-2">
                <legend class="font-data text-[0.7rem] tracking-[0.12em] text-room-ink-3">
                  {option.name}
                </legend>
                <div class="flex flex-wrap gap-2">
                  {option.values.map((value, valueIndex) => (
                    <label class="cursor-pointer">
                      <input
                        type="radio"
                        name={`option-${optionIndex}`}
                        value={value.label}
                        checked={valueIndex === 0}
                        data-option
                        data-option-name={option.name}
                        class="peer sr-only"
                      />
                      <span class="inline-flex min-h-11 items-center gap-2 border border-hairline px-3 text-sm text-room-ink-2 transition-colors peer-checked:border-outline peer-checked:text-room-ink peer-focus-visible:ring-2 peer-focus-visible:ring-outline/40">
                        {value.swatch && (
                          <span
                            aria-hidden="true"
                            class="size-3.5 rounded-full border border-hairline"
                            style={`background:${value.swatch}`}
                          />
                        )}
                        {value.label}
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))
          }

          {
            gone ? (
              <Button type="button" disabled>
                نفدت الكمية
              </Button>
            ) : (
              <div class="flex flex-wrap items-center gap-4">
                <label class="flex min-h-11 items-center gap-3 border border-hairline bg-exhibit px-3 focus-within:border-outline focus-within:ring-2 focus-within:ring-outline/40">
                  <span class="text-sm text-room-ink-2">الكمية</span>
                  <input
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    class="wq-field-bare w-14 p-0 text-center font-data text-sm text-ink"
                  />
                </label>
                <Button
                  type="button"
                  data-add-to-cart
                  data-product-id={product.id}
                  data-product-slug={product.slug}
                  data-product-name={product.name}
                  data-product-price={product.price}
                  data-product-image={thumbnail}
                  data-product-stock={product.quantity ?? ''}
                >
                  أضف إلى السلة
                </Button>
              </div>
            )
          }
        </div>

        <dl class="grid gap-4 border-t border-hairline pt-6 text-sm sm:grid-cols-2">
          {
            product.standard && (
              <div class="space-y-1">
                <dt class="font-data text-[0.7rem] tracking-[0.12em] text-room-ink-3">
                  <a href={`${url('/')}#standard`} class="transition-colors hover:text-room-ink">
                    المعيار
                  </a>
                </dt>
                <dd class="leading-relaxed text-room-ink-2">{product.standard}</dd>
              </div>
            )
          }
          <div class="space-y-1">
            <dt class="font-data text-[0.7rem] tracking-[0.12em] text-room-ink-3">التوفّر</dt>
            <dd class="leading-relaxed text-room-ink-2">
              {availability} · شحن خلال يومي عمل
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <ProductGrid products={related} title="قطع قريبة من هذه" />
  </main>

  <SiteFooter />
</Base>

<script>
  const stage = document.querySelector<HTMLImageElement>('[data-gallery-main]');
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && thumbs.length > 1) {
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const src = thumb.dataset.src;
        if (!src) return;

        if (reduceMotion) {
          stage.src = src;
        } else {
          /* Out, swap, back in — a tick later, so a cached image fades too. */
          stage.style.opacity = '0';
          stage.src = src;
          window.setTimeout(() => (stage.style.opacity = ''), 16);
        }

        if (thumb.dataset.alt) stage.alt = thumb.dataset.alt;
        thumbs.forEach((other) => other.setAttribute('aria-pressed', String(other === thumb)));
      });
    });
  }
</script>
