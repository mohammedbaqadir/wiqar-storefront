---
import { toArabicDigits } from '@/lib/format';
import { url } from '@/lib/url';

const year = toArabicDigits(new Date().getFullYear());
const linkClass =
  'font-medium transition-colors hover:text-deep-ink';
---

<footer class="mt-20 bg-deep text-deep-ink">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-5 py-14 lg:grid-cols-3 lg:px-8">
    <div class="space-y-4">
      <h3
        class="relative pb-2 font-display text-lg text-deep-ink after:absolute after:bottom-0 after:start-0 after:h-[2px] after:w-5 after:bg-accent"
      >
        <svg class="inline-block h-[0.95rem] w-auto" viewBox="0 0 131.18 100" aria-hidden="true"><use href="#wq-word"></use></svg>
        <span class="sr-only">وقار</span>
      </h3>
      <p class="max-w-sm font-reading text-base leading-loose text-deep-ink-2">
        مقتنيات بمعيار واحد: الجودة والذوق والقيمة في مستوى واحد. القطعة التي لا تجتاز
        الأسئلة الثلاثة لا تُعرض.
      </p>
    </div>

    <div class="space-y-3">
      <h3
        class="relative pb-2 font-display text-lg text-deep-ink after:absolute after:bottom-0 after:start-0 after:h-[2px] after:w-5 after:bg-accent"
      >
        تواصل
      </h3>
      <ul class="space-y-2 font-data text-sm text-deep-ink-2" dir="ltr">
        <li>support@wiqar.sa</li>
        <li>+966 53 686 2097</li>
      </ul>
      <p class="text-sm text-deep-ink-2">خدمة العملاء: ٩ صباحًا — ٩ مساءً</p>
      <p class="text-sm">
        <a href={url('/service#contact')} class={linkClass}>تواصل معنا</a>
      </p>
    </div>

    <div class="space-y-3">
      <h3
        class="relative pb-2 font-display text-lg text-deep-ink after:absolute after:bottom-0 after:start-0 after:h-[2px] after:w-5 after:bg-accent"
      >
        في المتجر
      </h3>
      <ul class="space-y-2 text-sm text-deep-ink-2">
        <li><a href={url('/catalog')} class={linkClass}>كل المقتنيات</a></li>
        <li><a href={`${url('/')}#standard`} class={linkClass}>معيار الاختيار</a></li>
        <li><a href={url('/service#shipping')} class={linkClass}>الشحن والتوصيل</a></li>
        <li><a href={url('/service#returns')} class={linkClass}>الإرجاع والاستبدال</a></li>
      </ul>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="h-px bg-deep-ink/15"></div>
  </div>

  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-5 py-5 text-center text-[0.75rem] tracking-[0.04em] text-deep-ink-2 sm:flex-row lg:px-8"
  >
    <span>الأسعار تشمل ضريبة القيمة المضافة · الشحن يُحسب عند الدفع</span>
    <div class="flex items-center gap-4">
      <button
        type="button"
        data-world-toggle
        aria-pressed="false"
        aria-label="تبديل الإضاءة بين النهار والليل"
        class="inline-flex min-h-11 items-center gap-2 border border-deep-ink/20 px-3 text-[0.75rem] text-deep-ink-2 transition-colors hover:border-accent hover:text-deep-ink"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
        >
          <path d="M9 18h6M10 21h4"></path>
          <path d="M12 3a6 6 0 0 1 6 6c0 2.4-1.4 3.9-2.4 5.4-.6.9-.6 1.7-.6 2.6H9c0-.9 0-1.7-.6-2.6C7.4 12.9 6 11.4 6 9a6 6 0 0 1 6-6z"></path>
        </svg>
        <span data-world-label>الليل</span>
      </button>
      <svg viewBox="0 0 32 32" class="size-5 text-[var(--wq-accent)]" fill="currentColor" aria-hidden="true">
        <path d="M16 5.5 L21.8 13.4 L16 21.3 L10.2 13.4 Z"></path>
        <rect x="9.6" y="25" width="12.8" height="2.1" rx="1.05"></rect>
      </svg>
      <span dir="ltr">© {year} WIỌAR</span>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    /* Re-runs after every navigation (astro:page-load) — the swapped-in button
       is a new element, so each one gets its own binding; the marker keeps the
       initial load and the first astro:page-load from double-binding. */
    var init = function () {
      var button = document.querySelector('[data-world-toggle]');
      if (!button || button.dataset.wqBound) return;
      button.dataset.wqBound = 'true';

      var label = button.querySelector('[data-world-label]');
      var paint = function () {
        var night = document.documentElement.dataset.world === 'night';
        if (label) label.textContent = night ? 'النهار' : 'الليل';
        button.setAttribute('aria-pressed', String(night));
      };

      paint();
      button.addEventListener('click', function () {
        var next = document.documentElement.dataset.world === 'night' ? 'day' : 'night';
        document.documentElement.dataset.world = next;
        try {
          localStorage.setItem('wq-world', next);
        } catch (error) {
          /* private mode: the choice simply does not persist */
        }
        paint();
      });
    };

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
