---
import { getCategories, getProducts } from '@/lib/catalog';
import { url } from '@/lib/url';

const categories = await getCategories();
const products = await getProducts();

const withCounts = categories
  .map((category) => ({
    category,
    count: products.filter((product) => product.category_id === category.id).length,
  }))
  .filter((entry) => entry.count > 0);
---

<nav class="mx-auto max-w-6xl px-5 pt-8 pb-10 lg:px-8" aria-label="أقسام المتجر">
  <div class="flex flex-wrap border-x border-b border-hairline">
    {
      withCounts.map(({ category }) => (
        <a
          href={url(`/category/${category.slug}`)}
          class="flex min-h-11 min-w-0 flex-auto items-center justify-center border-hairline px-4 text-sm whitespace-nowrap text-room-ink transition-colors hover:bg-room-2 [&+&]:border-s"
        >
          <span class="font-medium">{category.name}</span>
        </a>
      ))
    }
  </div>
</nav>
