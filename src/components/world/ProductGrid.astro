---
import ProductPhoto from './ProductPhoto.astro';
import {
  getCategories,
  isLowStock,
  isOnSale,
  isOutOfStock,
  lowStockLabel,
  type ApiProduct,
} from '@/lib/api';
import { money } from '@/lib/format';
import { normalize, searchText } from '@/lib/search';
import { url } from '@/lib/url';

interface Props {
  products: ApiProduct[];
  title?: string;
  /** Emits the data the client filters on (search and category). */
  indexed?: boolean;
}

const { products, title, indexed = false } = Astro.props;

const categories = indexed ? await getCategories() : [];
const roomOf = (id: number) => categories.find((category) => category.id === id);
/** Cards sit under the grid's h2 when there is one; otherwise they are the page's h2s. */
const CardHeading = title ? 'h3' : 'h2';
---

<section class="mx-auto max-w-6xl px-5 py-12 lg:px-8 lg:py-16">
  {
    title && (
      <header class="mb-8">
        <h2 class="font-display text-2xl text-room-ink lg:text-3xl">{title}</h2>
      </header>
    )
  }

  <div class="grid grid-cols-2 gap-x-4 gap-y-9 md:grid-cols-3 lg:grid-cols-4 lg:gap-x-6">
    {
      products.map((product) => {
        const room = roomOf(product.category_id);
        const gone = isOutOfStock(product);
        /** Pieces with choices cannot be quick-added: the shopper must choose. */
        const needsChoosing = product.options.length > 0;

        return (
          <div
            class="group relative flex flex-col"
            data-product-card=""
            data-price={product.price}
            data-created={product.created_at}
            data-category={indexed ? (room?.slug ?? '') : undefined}
            data-search={
              indexed
                ? searchText(
                    product.name,
                    product.subtitle,
                    product.origin,
                    product.standard,
                    product.description,
                    product.sku,
                    room?.name,
                    ...(product.keywords ?? [])
                  )
                : undefined
            }
            data-name={indexed ? normalize(product.name) : undefined}
          >
            <div class="relative aspect-square w-full overflow-hidden bg-exhibit-2">
              <ProductPhoto
                path={product.image.url}
                alt={product.image.alt}
                class:list={[
                  'size-full object-cover transition-[transform,opacity] duration-[900ms] ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none group-hover:scale-[1.05]',
                  gone && 'opacity-55',
                ]}
              />

              {gone && (
                <span class="absolute start-3 top-3 bg-ink px-2 py-0.5 font-data text-[0.7rem] text-exhibit">
                  نفدت
                </span>
              )}

              {isLowStock(product) && (
                <span class="absolute start-3 top-3 bg-signal px-2 py-0.5 font-data text-[0.7rem] text-exhibit">
                  {lowStockLabel(product)}
                </span>
              )}

              {isOnSale(product) && (
                <span class="absolute end-3 top-3 bg-ink px-2 py-0.5 text-[0.7rem] text-exhibit">
                  عرض
                </span>
              )}

              {/* Touch has no hover: a standing chevron says the card opens. */}
              <span
                data-touch-cue
                aria-hidden="true"
                class="absolute end-3 bottom-3 z-10 size-8 place-items-center bg-exhibit/90 text-ink-2"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-4"
                  aria-hidden="true"
                >
                  <path d="M14 6l-6 6 6 6"></path>
                </svg>
              </span>

              {/* Pointer users get quick add — but never past a choice they have to
                  make. With options, the product page is the honest path. */}
              {!gone && !needsChoosing && (
                <button
                  type="button"
                  data-add-to-cart
                  data-quick-add
                  data-product-id={product.id}
                  data-product-slug={product.slug}
                  data-product-name={product.name}
                  data-product-price={product.price}
                  data-product-image={product.image.url}
                  data-product-stock={product.quantity ?? ''}
                  aria-label={`أضف ${product.name} إلى السلة`}
                  class="absolute inset-x-3 bottom-3 z-10 min-h-11 items-center justify-center bg-ink/90 px-3 text-sm text-exhibit transition-opacity hover:bg-ink"
                >
                  أضف إلى السلة
                </button>
              )}

              {!gone && needsChoosing && (
                <a
                  href={url(`/product/${product.slug}`)}
                  data-quick-add
                  class="absolute inset-x-3 bottom-3 z-10 min-h-11 items-center justify-center bg-ink/90 px-3 text-sm text-exhibit transition-opacity hover:bg-ink"
                >
                  اختر {product.options[0].name}
                </a>
              )}
            </div>

            <div class="mt-3 flex items-start justify-between gap-3">
              <div class="min-w-0">
                <CardHeading class="truncate text-[0.95rem] text-room-ink">
                  <a
                    href={url(`/product/${product.slug}`)}
                    class="transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent-d group-hover:underline group-hover:decoration-accent group-hover:decoration-2 group-hover:underline-offset-4"
                  >
                    {product.name}
                  </a>
                </CardHeading>
                {/* What the piece is made of — the line that justifies it. */}
                {product.origin && (
                  <p class="mt-0.5 truncate font-reading text-[0.85rem] leading-relaxed text-room-ink-3">
                    {product.origin}
                  </p>
                )}
              </div>

              <div class="shrink-0 text-end">
                {isOnSale(product) ? (
                  <>
                    <p class="font-data text-sm text-room-ink">
                      {money(product.sale_price ?? product.price)}
                    </p>
                    <p class="font-data text-[0.7rem] text-room-ink-3 line-through">
                      {money(product.regular_price)}
                    </p>
                  </>
                ) : (
                  <p class="font-data text-sm text-room-ink">{money(product.price)}</p>
                )}
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
