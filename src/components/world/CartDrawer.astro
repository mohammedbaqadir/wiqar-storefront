---
import { url } from '@/lib/url';
---

<div
  data-cart-drawer
  inert
  class="group/cart pointer-events-none fixed inset-0 z-50 opacity-0 transition-opacity duration-200 data-[open]:pointer-events-auto data-[open]:opacity-100"
>
  <div data-cart-overlay class="absolute inset-0 bg-scrim/50"></div>

  <aside
    data-cart-panel
    role="dialog"
    aria-modal="true"
    aria-label="سلة المشتريات"
    class="absolute inset-y-0 end-0 flex w-full max-w-md flex-col bg-exhibit text-ink shadow-[0_28px_70px_-28px_var(--wq-scrim)]"
  >
    <header class="flex items-center justify-between gap-4 border-b border-hairline-ink px-5 py-4">
      <h2 class="font-display text-xl">
        السلة
        <span data-cart-drawer-count class="font-data text-sm text-ink-3"></span>
      </h2>
      <button
        type="button"
        data-cart-close
        aria-label="إغلاق السلة"
        class="grid size-11 place-items-center text-ink transition-colors hover:text-accent-d"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          class="size-4.5"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </header>

    <div
      data-cart-empty
      data-show
      class="hidden flex-1 flex-col items-center justify-center gap-3 p-8 text-center data-[show]:flex"
    >
      <p class="font-display text-lg text-ink">سلتك فارغة</p>
      <p class="text-sm leading-relaxed text-ink-2">لم تُضف أي قطعة بعد.</p>
      <a
        href={url('/catalog')}
        class="mt-2 inline-flex min-h-11 items-center border border-hairline-ink px-4 text-sm text-ink transition-colors hover:bg-exhibit-2"
      >
        تصفّح المتجر
      </a>
    </div>

    <ul
      data-cart-lines
      class="hidden flex-1 flex-col overflow-y-auto px-5 py-1 data-[show]:flex"
    >
    </ul>

    <footer
      data-cart-footer
      class="hidden flex-col gap-4 border-t border-hairline-ink px-5 py-4 data-[show]:flex"
    >
      <div class="space-y-2">
        <p data-cart-shipping class="text-[0.8rem] text-ink-2"></p>
        <div class="h-[3px] w-full bg-exhibit-2">
          <span
            data-cart-progress
            class="block h-full bg-accent transition-[width] duration-300"
            style="width:0%"></span>
        </div>
      </div>

      <div class="flex items-baseline justify-between gap-4">
        <span class="text-sm text-ink-2">المجموع الفرعي</span>
        <span data-cart-subtotal class="wq-price text-xl text-ink"></span>
      </div>

      <p class="text-[0.75rem] leading-relaxed text-ink-3">
        الشحن يُحسب عند الدفع · إرجاع خلال ١٤ يومًا
      </p>

      <a
        href={url('/checkout')}
        class="inline-flex min-h-11 items-center justify-center bg-ink px-4 text-sm text-exhibit transition-colors hover:bg-ink/90"
      >
        إتمام الشراء
      </a>

      <button
        type="button"
        data-cart-close-continue
        class="min-h-11 border border-hairline-ink px-4 text-sm text-ink transition-colors hover:bg-exhibit-2"
      >
        متابعة التسوّق
      </button>
    </footer>

    <p data-cart-announce aria-live="polite" class="sr-only"></p>
  </aside>
</div>

<template data-cart-line-template>
  <li class="flex gap-3 border-b border-hairline-ink py-4">
    <img class="size-20 shrink-0 bg-exhibit-2 object-cover" alt="" />
    <div class="flex min-w-0 flex-1 flex-col justify-between gap-2">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <a
            data-line-name
            class="block truncate text-sm text-ink transition-colors hover:text-accent-d"
          ></a>
          <p data-line-options class="mt-0.5 font-data text-[0.7rem] text-ink-3" hidden></p>
        </div>
        <button
          type="button"
          data-line-remove
          class="-me-1 inline-flex min-h-11 shrink-0 items-center px-1.5 text-[0.7rem] text-ink-3 transition-colors hover:text-signal"
        >
          إزالة
        </button>
      </div>
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center border border-hairline-ink">
          <button
            type="button"
            data-line-inc
            aria-label="زيادة الكمية"
            class="size-11 text-ink transition-colors hover:bg-exhibit-2 disabled:opacity-35"
          >
            +
          </button>
          <span data-line-qty class="min-w-8 text-center font-data text-sm text-ink"></span>
          <button
            type="button"
            data-line-dec
            aria-label="إنقاص الكمية"
            class="size-11 text-ink transition-colors hover:bg-exhibit-2"
          >
            −
          </button>
        </div>
        <span data-line-price class="wq-price text-base text-ink"></span>
      </div>
    </div>
  </li>
</template>

<script>
  import {
    addLine,
    lineKey,
    optionLabel,
    readCart,
    removeLine,
    setQuantity,
    subscribe,
    totals,
    type CartLine,
  } from '@/lib/cart';
  import { money, toArabicDigits } from '@/lib/format';
  import { url } from '@/lib/url';

  const drawer = document.querySelector<HTMLElement>('[data-cart-drawer]');
  const panel = drawer?.querySelector<HTMLElement>('[data-cart-panel]');
  const overlay = drawer?.querySelector<HTMLElement>('[data-cart-overlay]');
  const list = drawer?.querySelector<HTMLElement>('[data-cart-lines]');
  const empty = drawer?.querySelector<HTMLElement>('[data-cart-empty]');
  const footer = drawer?.querySelector<HTMLElement>('[data-cart-footer]');
  const template = document.querySelector<HTMLTemplateElement>('[data-cart-line-template]');
  const drawerCount = drawer?.querySelector<HTMLElement>('[data-cart-drawer-count]');
  const subtotalEl = drawer?.querySelector<HTMLElement>('[data-cart-subtotal]');
  const shippingEl = drawer?.querySelector<HTMLElement>('[data-cart-shipping]');
  const progressEl = drawer?.querySelector<HTMLElement>('[data-cart-progress]');
  const announceEl = drawer?.querySelector<HTMLElement>('[data-cart-announce]');
  const countEls = document.querySelectorAll<HTMLElement>('[data-cart-count]');

  if (
    drawer &&
    panel &&
    overlay &&
    list &&
    empty &&
    footer &&
    template &&
    subtotalEl &&
    shippingEl &&
    progressEl
  ) {
    /** A re-render replaces every row, so remember where the focus was. */
    let pendingFocus: { key: string; action: 'inc' | 'dec' | 'remove' } | null = null;
    let lastFocused: HTMLElement | null = null;
    /** The first render is not a change: nothing ticks on page load. */
    let firstRender = true;
    let shownCount = 0;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setShown = (element: HTMLElement, shown: boolean) => {
      if (shown) element.setAttribute('data-show', '');
      else element.removeAttribute('data-show');
    };

    const buildLine = (line: CartLine): HTMLElement => {
      const node = (template.content.firstElementChild as HTMLElement).cloneNode(
        true
      ) as HTMLElement;
      node.setAttribute('data-line-id', line.key);

      const image = node.querySelector('img') as HTMLImageElement;
      image.src = line.image;
      image.alt = line.name;

      const name = node.querySelector('[data-line-name]') as HTMLAnchorElement;
      name.textContent = line.name;
      name.href = url(`/product/${line.slug}`);

      const options = node.querySelector('[data-line-options]') as HTMLElement;
      const chosen = optionLabel(line.options);
      if (chosen) {
        options.textContent = chosen;
        options.hidden = false;
      }

      const quantity = node.querySelector('[data-line-qty]') as HTMLElement;
      quantity.textContent = toArabicDigits(line.quantity);

      const price = node.querySelector('[data-line-price]') as HTMLElement;
      price.textContent = money(line.price * line.quantity);

      const increase = node.querySelector('[data-line-inc]') as HTMLButtonElement;
      increase.disabled = line.max !== null && line.quantity >= line.max;
      increase.addEventListener('click', () => {
        pendingFocus = { key: line.key, action: 'inc' };
        setQuantity(line.key, line.quantity + 1);
      });

      const decrease = node.querySelector('[data-line-dec]') as HTMLButtonElement;
      decrease.addEventListener('click', () => {
        pendingFocus = { key: line.key, action: 'dec' };
        setQuantity(line.key, line.quantity - 1);
      });

      const remove = node.querySelector('[data-line-remove]') as HTMLButtonElement;
      remove.addEventListener('click', () => {
        pendingFocus = { key: line.key, action: 'remove' };
        removeLine(line.key);
      });

      return node;
    };

    const render = (lines: CartLine[]) => {
      list.replaceChildren(...lines.map(buildLine));

      /** Re-rendered rows lose the focus ring: put it back on the same control. */
      if (pendingFocus) {
        const row = list.querySelector<HTMLElement>(`[data-line-id="${pendingFocus.key}"]`);
        const selector =
          pendingFocus.action === 'remove'
            ? '[data-line-remove]'
            : `[data-line-${pendingFocus.action}]`;
        const target = row?.querySelector<HTMLButtonElement>(selector);
        if (target && !target.disabled) target.focus();
        else row?.querySelector<HTMLButtonElement>('[data-line-dec]')?.focus();
        pendingFocus = null;
      }

      const summary = totals(lines);
      const hasItems = lines.length > 0;

      setShown(empty, !hasItems);
      setShown(list, hasItems);
      setShown(footer, hasItems);

      if (drawerCount) drawerCount.textContent = hasItems ? `(${toArabicDigits(summary.count)})` : '';

      const grew = !firstRender && summary.count > shownCount;
      shownCount = summary.count;
      firstRender = false;

      countEls.forEach((element) => {
        element.textContent = toArabicDigits(summary.count);
        element.hidden = summary.count === 0;

        /* One quiet tick when something is added, nothing on the way out. */
        if (grew && !reduceMotion) {
          element.animate(
            [{ transform: 'scale(1)' }, { transform: 'scale(1.4)' }, { transform: 'scale(1)' }],
            { duration: 320, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
          );
        }
      });

      subtotalEl.textContent = money(summary.subtotal);

      if (summary.toFreeShipping === 0) {
        shippingEl.textContent = 'التوصيل مجاني على هذا الطلب.';
        progressEl.style.width = '100%';
      } else {
        shippingEl.textContent = `أضف ${money(summary.toFreeShipping)} للحصول على توصيل مجاني.`;
        const share = Math.round((summary.subtotal / summary.freeShippingAt) * 100);
        progressEl.style.width = `${Math.min(100, share)}%`;
      }
    };

    const focusableInPanel = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled])')
      );

    const open = () => {
      lastFocused = document.activeElement as HTMLElement | null;
      drawer.removeAttribute('inert');
      drawer.setAttribute('data-open', '');
      document.body.style.overflow = 'hidden';
      panel.querySelector<HTMLElement>('[data-cart-close]')?.focus();
    };

    const close = () => {
      drawer.removeAttribute('data-open');
      drawer.setAttribute('inert', '');
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    drawer.querySelector('[data-cart-close]')?.addEventListener('click', close);
    drawer.querySelector('[data-cart-close-continue]')?.addEventListener('click', close);
    overlay.addEventListener('click', close);

    document.addEventListener('keydown', (event) => {
      if (!drawer.hasAttribute('data-open')) return;

      if (event.key === 'Escape') {
        close();
        return;
      }
      if (event.key !== 'Tab') return;

      const items = focusableInPanel();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    document.querySelectorAll<HTMLElement>('[data-cart-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        if (drawer.hasAttribute('data-open')) close();
        else open();
      });
    });

    document.querySelectorAll<HTMLElement>('[data-add-to-cart]').forEach((button) => {
      button.addEventListener('click', () => {
        const data = button.dataset;
        const buy = button.closest('[data-buy]');
        const quantityInput = buy?.querySelector<HTMLInputElement>('input[name="quantity"]');
        const chosen = Array.from(buy?.querySelectorAll<HTMLInputElement>('[data-option]:checked') ?? [])
          .map((input) => ({ name: input.dataset.optionName ?? '', value: input.value }))
          .filter((option) => option.name !== '' && option.value !== '');
        const name = data.productName ?? '';
        const key = lineKey(Number(data.productId), chosen.length > 0 ? chosen : undefined);

        addLine(
          {
            id: Number(data.productId),
            slug: data.productSlug ?? '',
            name,
            options: chosen.length > 0 ? chosen : undefined,
            price: Number(data.productPrice ?? 0),
            image: data.productImage ?? '',
            max: data.productStock ? Number(data.productStock) : null,
          },
          quantityInput ? Number(quantityInput.value) || 1 : 1
        );

        if (announceEl) announceEl.textContent = `أُضيف ${name} إلى السلة.`;
        open();

        /* Mark the line that just arrived, so the eye finds it in the drawer. */
        if (!reduceMotion) {
          list
            .querySelector<HTMLElement>(`[data-line-id="${CSS.escape(key)}"]`)
            ?.animate(
              [{ backgroundColor: 'rgba(176, 141, 87, 0.18)' }, { backgroundColor: 'transparent' }],
              { duration: 900, easing: 'ease-out' }
            );
        }
      });
    });

    subscribe(render);
    render(readCart());
  }
</script>
