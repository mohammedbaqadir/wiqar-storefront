---
import { url } from '@/lib/url';

const links = [{ href: url('/catalog'), label: 'المقتنيات' }];
---

<aside aria-label="معلومات المتجر" class="border-b border-hairline bg-room-2">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-2 text-[0.75rem] text-room-ink-3 lg:px-8"
  >
    <a href={url('/service#shipping')} class="transition-colors hover:text-room-ink">
      توصيل مجاني للطلبات فوق ٥٠٠ ر.س
    </a>
    <a
      href={url('/service#returns')}
      class="hidden transition-colors hover:text-room-ink sm:inline"
    >
      إرجاع خلال ١٤ يومًا · الدفع عند الاستلام متاح
    </a>
  </div>
</aside>

<header class="sticky top-0 z-40 border-b border-hairline bg-room">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-5 py-4 lg:px-8">
    <a href={url('/')} class="flex items-baseline gap-3">
      <span class="font-display text-3xl leading-none text-room-ink">وقار</span>
      <span
        class="hidden font-data text-[0.7rem] tracking-[0.2em] text-room-ink-3 md:inline"
        dir="ltr">WIỌAR</span
      >
    </a>

    <nav class="flex items-center gap-6 text-sm" aria-label="التنقل">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-room-ink-2 transition-colors hover:text-room-ink hover:underline hover:decoration-accent hover:decoration-2 hover:underline-offset-4"
          >
            {link.label}
          </a>
        ))
      }

      <form
        action={url('/search')}
        method="get"
        role="search"
        class="hidden items-center gap-2 border-b border-hairline pb-1 focus-within:border-outline focus-within:ring-2 focus-within:ring-outline/40 sm:flex"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          class="size-4 shrink-0 text-room-ink-3"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="6"></circle>
          <path d="M20 20l-4.2-4.2"></path>
        </svg>
        <input
          type="search"
          name="q"
          autocomplete="off"
          placeholder="ابحث"
          aria-label="ابحث في المتجر"
          class="wq-field-bare min-h-11 w-24 text-sm text-room-ink placeholder:text-room-ink-3 lg:w-36"
        />
      </form>

      <a
        href={url('/search')}
        class="inline-flex min-h-11 min-w-11 items-center justify-center text-room-ink-2 transition-colors hover:text-room-ink sm:hidden"
        aria-label="البحث"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          class="size-4.5"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="6"></circle>
          <path d="M20 20l-4.2-4.2"></path>
        </svg>
      </a>

      <button
        type="button"
        data-cart-toggle
        class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 text-room-ink transition-colors hover:text-accent-d"
        aria-label="السلة"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4.5"
          aria-hidden="true"
        >
          <path d="M6 8h12l-1 11H7z"></path>
          <path d="M9 8a3 3 0 0 1 6 0"></path>
        </svg>
        <span data-cart-count class="font-data text-[0.7rem] leading-none" hidden></span>
      </button>
    </nav>
  </div>
</header>
