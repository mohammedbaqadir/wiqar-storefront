---
interface Props {
  /** Catalogue image URL. */
  path: string;
  alt: string;
  /** Above-the-fold photos load eagerly and high priority. */
  priority?: boolean;
  class?: string;
}

const { path, alt, priority = false, class: className = '', ...rest } = Astro.props;
---

{
  path ? (
    <img
      src={path}
      alt={alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      class={className}
      {...rest}
    />
  ) : (
    <span class={`block bg-exhibit-2 ${className}`} aria-hidden="true" />
  )
}
